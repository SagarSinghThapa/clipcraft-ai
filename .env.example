# =================================================================
# ClipCraft AI - Environment Configuration Example
# Copy this file to .env to customize your local configuration
# =================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Hardware & Compute ('auto', 'cpu', 'cuda')
DEVICE=auto
COMPUTE_TYPE=auto

# External Tool Executables (if not in system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Local Ollama Inference Server
OLLAMA_BASE_URL=http://localhost:11434

# AI Model Selections
DEFAULT_WHISPER_MODEL=base
DEFAULT_LLM_MODEL=llama3.2:3b

# Short-Form Video Defaults
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
DEFAULT_MIN_CLIP_DURATION=15
DEFAULT_MAX_CLIP_DURATION=60
DEFAULT_CANDIDATE_COUNT=5
